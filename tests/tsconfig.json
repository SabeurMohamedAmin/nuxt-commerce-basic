{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["vitest/globals"],
    "baseUrl": "..",
    "paths": {
      "~/*": ["./app/*"],
      "~~/*": ["./*"]
    }
  },
  "include": ["./**/*.ts"]
}
